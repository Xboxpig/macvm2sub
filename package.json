{
  "name": "macvm2sub",
  "private": true,
  "version": "0.2.0",
  "description": "Single-account macOS API gateway driven by the official Codex TUI",
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "setup:macos": "node scripts/macos.mjs init",
    "login:codex": "node scripts/macos.mjs login",
    "status:codex": "node scripts/macos.mjs status",
    "start:macos": "node scripts/macos.mjs start",
    "start": "node --env-file-if-exists=.env.macos src/server.mjs",
    "test": "node --test test/tui/*.test.mjs test/server.test.mjs",
    "test:native": "node scripts/test-native.mjs",
    "build:web": "npm --prefix console run build"
  },
  "dependencies": {
    "ws": "^8.22.0"
  }
}
